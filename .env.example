# ============================================
# WMS Environment Variables
# Copy this file to .env and customize values
# ============================================

# === Database Configuration ===
DB_NAME=wms
DB_USER=wms_user
DB_PASS=change_this_secure_password

# === Spring Profile ===
# Use 'dev' for local development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev

# === JWT Security ===
# IMPORTANT: Change this to a secure random string in production!
# Minimum 32 characters recommended
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# === Server ===
SERVER_PORT=8080

# === Database External Port (for development) ===
DB_EXTERNAL_PORT=5433

# === HTTP Port (Nginx/Caddy) ===
HTTP_PORT=80

# === CORS (Production) ===
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# === Domain (for Caddy/HTTPS in production) ===
DOMAIN=localhost

# === Printer Configuration (optional) ===
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_PORT=9100
