{
    "name": "wms-screenshots",
    "version": "1.0.0",
    "private": true,
    "description": "Screenshot automation for WMS Warehouse Management System",
    "scripts": {
        "screenshots": "npx tsx scripts/capture-screenshots.ts",
        "screenshots:desktop": "npx tsx scripts/capture-screenshots.ts --desktop-only",
        "screenshots:mobile": "npx tsx scripts/capture-screenshots.ts --mobile-only"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/node": "^25.0.8",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}
