# ============================================
# WMS Environment Variables
# Copy this file to .env and customize values
# ============================================

# Database Configuration
DB_NAME=wms
DB_USER=wms
DB_PASS=wms

# External port for direct DB access (optional, for debugging)
DB_EXTERNAL_PORT=5433

# HTTP port for Nginx (main entry point)
HTTP_PORT=80

# Printer Configuration (optional)
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_PORT=9100
