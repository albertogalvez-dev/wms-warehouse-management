# ============================================
# WMS Environment Variables
# Copy: cp .env.example .env
# Then edit .env with your production values
# ============================================

# === Database Configuration ===
DB_NAME=wms
DB_USER=wms_user
DB_PASS=change_this_secure_password_here

# === Spring Boot Database (used in production) ===
# These are automatically set from DB_* vars in docker-compose.prod.yml
# but can be overridden if needed:
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/wms
# SPRING_DATASOURCE_USERNAME=wms_user
# SPRING_DATASOURCE_PASSWORD=your_password

# === Spring Profile ===
# 'dev' = local development (swagger enabled, relaxed CORS)
# 'prod' = production (swagger disabled, strict security)
SPRING_PROFILES_ACTIVE=dev

# === JWT Security ===
# IMPORTANT: Change this to a secure random string (32+ chars) in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# === Server ===
SERVER_PORT=8080

# === WMS Nginx Port (docker-compose.yml) ===
# Bind WMS nginx to localhost to avoid clashing with system nginx
WMS_HTTP_PORT=8081

# === Domain (for HTTPS with Caddy) ===
# Set your domain for automatic HTTPS (Let's Encrypt)
# If using IP address only, use: DOMAIN=:80 (HTTP only, no HTTPS)
# Examples:
#   DOMAIN=wms.example.com     → HTTPS automatic
#   DOMAIN=192.168.1.100:80    → HTTP only (no HTTPS)
#   DOMAIN=localhost           → Local dev (HTTP)
DOMAIN=localhost

# === CORS (for API access from other domains) ===
# For production, set to your actual domain(s)
# For demo/testing, can use * to allow all origins
# Example: CORS_ALLOWED_ORIGINS=https://wms.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=*

# === Printer Configuration (optional) ===
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_PORT=9100
